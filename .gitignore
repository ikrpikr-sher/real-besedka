# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Avito cabinet secrets and MCP runtime state
avito/*.env
!avito/*.env.example
avito/.state/

# Avito AI-agent runtime
avito-ai-agent/.env
avito-ai-agent/logs/*.md
avito-ai-agent/logs/*.json
avito-ai-agent/database/*.db

# Google Search Console service account
secrets/
*.gserviceaccount.json

# SEO AI-agent runtime
real-besedki-seo-agent/.env
real-besedki-seo-agent/logs/*.md
real-besedki-seo-agent/logs/*.json
real-besedki-seo-agent/database/*.db


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent skill caches (not part of site)
.agents/
skills-lock.json

/app/generated/prisma

# SEO agent secrets
real-besedki-seo-agent/.env.*
!real-besedki-seo-agent/.env.example
real-besedki-seo-agent/reports/_keyso_probe/
real-besedki-seo-agent/__pycache__/
real-besedki-seo-agent/**/__pycache__/
