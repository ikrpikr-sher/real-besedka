# Скопируйте в .env (файл в git не попадает).
# Один Яндекс-аккаунт, у которого в кабинетах есть real-besedki.ru.

# --- Яндекс Вебмастер (чтение) ---
YANDEX_CLIENT_ID=
YANDEX_OAUTH_TOKEN=
YANDEX_WEBMASTER_USER_ID=
YANDEX_WEBMASTER_HOST_ID=

# --- Яндекс Метрика (чтение) ---
YANDEX_METRIKA_COUNTER_ID=111500128

# --- Google Search Console (чтение, сервисный аккаунт) ---
# JSON ключ НЕ в git. Положить: ~/secrets/real-besedki-gsc.json
# В GSC добавить email из JSON (…@….iam.gserviceaccount.com), право «Ограниченный».
GOOGLE_APPLICATION_CREDENTIALS=
GSC_SITE_URL=sc-domain:real-besedki.ru

# --- Сбор ядра: Keys.so (официальный API, квота тарифа) ---
# Токен: кабинет Keys.so → настройки → API. Не коммитить.
# KEYSO_TOKEN=

# --- Сбор ядра: Яндекс Wordstat Cloud Search API ---
# Консоль Yandex Cloud → сервисный аккаунт с ролью search-api.webSearch.user
# → API-ключ со scope yc.search-api.execute + folder ID.
# YANDEX_WORDSTAT_API_KEY=
# YANDEX_FOLDER_ID=

# Старый Wordstat v1 (OAuth), если Direct/поддержка выдали доступ:
# YANDEX_WORDSTAT_TOKEN=
